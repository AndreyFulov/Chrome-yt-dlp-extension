{
  "manifest_version": 3,
  "name": "chrome yt-dlp extension",
  "version": "0.5.1",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "storage", "cookies"],
  "host_permissions": ["https://*.youtube.com/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["locale.js", "popup.js", "youtube.js"],
    "css": ["youtube.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "chrome yt-dlp extension",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png", "32": "icons/icon32.png",
    "48": "icons/icon48.png", "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
